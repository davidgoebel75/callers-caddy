/* =============================================================
   Callers Caddy — Default Dark Skin
   =============================================================
   Platzhalter wie z.B. window_bg in doppelten geschweiften
   Klammern werden vom SkinManager durch Werte aus skin.json ersetzt.
   Verfuegbar: alle Keys aus "colors", plus font_size und skin_path.
   ============================================================= */

/* --- Globale Basis --- */
/* WICHTIG: QWidget NICHT mit background-color stylen!
   Das ueberschreibt Qt-interne Widgets (QRubberBand, Dock-Separatoren)
   und zerstoert das Dock-Snapping und die blauen Drop-Indikatoren. */
QMainWindow, QDialog {
    background-color: {{window_bg}};
    color: {{text}};
    font-size: {{font_size}};
}

/* Globale Schrift + Farbe (OHNE background-color!) */
QWidget {
    color: {{text}};
    font-size: {{font_size}};
}

/* Hintergrund nur fuer konkrete Container-Widgets */
QFrame, QGroupBox, QTabWidget::pane {
    background-color: {{widget_bg}};
}

/* --- Dock-System (Snapping + Indikatoren erhalten) --- */
QMainWindow::separator {
    background-color: {{border}};
    width: 4px;
    height: 4px;
}

QMainWindow::separator:hover {
    background-color: {{button_bg}};
}

/* Dock-Drop-Indikator (blauer Rahmen beim Andocken) */
QRubberBand {
    background-color: rgba(97, 95, 139, 80);
    border: 2px solid {{button_bg}};
}

/* --- Dock-Titelleisten --- */
QDockWidget {
    background-color: {{window_bg}};
    color: {{title_text}};
    font-weight: bold;
    font-size: {{font_size}};
    titlebar-close-icon: url({{icon_path}}/close.svg);
    titlebar-normal-icon: url({{icon_path}}/float.svg);
}

QDockWidget::title {
    background-color: {{title_bg}};
    padding: 6px;
    border: 1px solid {{border}};
}

/* Dock-Fenster-Buttons (Schliessen, Abdocken) */
QDockWidget::close-button, QDockWidget::float-button {
    border: 1px solid transparent;
    background: transparent;
    padding: 0px;
}

QDockWidget::close-button:hover, QDockWidget::float-button:hover {
    background-color: {{button_bg}};
}

QDockWidget::close-button:pressed, QDockWidget::float-button:pressed {
    padding: 1px -1px -1px 1px;
}

/* Inhalt der Dock-Widgets bekommt den Widget-Hintergrund */
QDockWidget > QWidget {
    background-color: {{widget_bg}};
}

/* --- Buttons --- */
QPushButton {
    background-color: {{button_bg}};
    color: {{button_text}};
    border: 1px solid {{border}};
    border-radius: 4px;
    padding: 5px 14px;
    font-size: {{font_size}};
}

QPushButton:hover {
    background-color: {{button_hover}};
}

QPushButton:pressed {
    background-color: {{button_pressed}};
}

QPushButton:disabled {
    background-color: {{muted_bg}};
    color: {{muted_text}};
    border-color: {{muted_bg}};
}

/* Toggle-Buttons (checkable): AN = normal, AUS = gedimmt */
QPushButton:checked {
    background-color: {{button_bg}};
    color: {{button_text}};
}

QPushButton:checked:hover {
    background-color: {{button_hover}};
}

QPushButton:!checked[checkable="true"] {
    background-color: {{muted_bg}};
    color: {{muted_text}};
    border-color: {{muted_bg}};
}

QPushButton:!checked[checkable="true"]:hover {
    background-color: {{button_bg}};
    color: {{button_text}};
}

/* --- Eingabefelder (SpinBox, LineEdit, DoubleSpinBox) --- */
QLineEdit, QSpinBox, QDoubleSpinBox, QTimeEdit {
    background-color: {{input_bg}};
    color: {{input_text}};
    border: 1px solid {{input_border}};
    border-radius: 3px;
    padding: 3px 5px;
    selection-background-color: {{selection_bg}};
    selection-color: {{selection_text}};
}

QLineEdit:read-only {
    background-color: {{muted_bg}};
    color: {{muted_text}};
}

QSpinBox::up-button, QDoubleSpinBox::up-button, QTimeEdit::up-button {
    background-color: {{button_bg}};
    border: none;
    border-left: 1px solid {{border}};
    width: 18px;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover, QTimeEdit::up-button:hover {
    background-color: {{button_hover}};
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow, QTimeEdit::up-arrow {
    image: url({{icon_path}}/arrow-up.svg);
    width: 8px;
    height: 5px;
}

QSpinBox::down-button, QDoubleSpinBox::down-button, QTimeEdit::down-button {
    background-color: {{button_bg}};
    border: none;
    border-left: 1px solid {{border}};
    width: 18px;
}

QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover, QTimeEdit::down-button:hover {
    background-color: {{button_hover}};
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow, QTimeEdit::down-arrow {
    image: url({{icon_path}}/arrow-down.svg);
    width: 8px;
    height: 5px;
}

/* --- Listen (Songliste, Club-Liste) --- */
QListWidget, QListView {
    background-color: {{input_bg}};
    alternate-background-color: {{alt_row_bg}};
    color: {{text}};
    border: 1px solid {{input_border}};
    border-radius: 3px;
    outline: none;
}

QListWidget::item {
    padding: 4px 6px;
    border-bottom: 1px solid {{window_bg}};
}

QListWidget::item:selected {
    background-color: {{selection_bg}};
    color: {{selection_text}};
}

QListWidget::item:hover {
    background-color: {{muted_bg}};
}

/* --- Tabellen (QTableWidget) --- */
QTableWidget, QTableView {
    background-color: {{input_bg}};
    alternate-background-color: {{alt_row_bg}};
    color: {{text}};
    border: 1px solid {{input_border}};
    border-radius: 3px;
    gridline-color: {{border}};
    outline: none;
}

QTableWidget::item {
    padding: 3px 5px;
}

QTableWidget::item:selected {
    background-color: {{selection_bg}};
    color: {{selection_text}};
}


QHeaderView::section {
    background-color: {{title_bg}};
    color: {{title_text}};
    border: 1px solid {{border}};
    padding: 4px 6px;
    font-weight: bold;
}

/* --- ComboBox --- */
QComboBox {
    background-color: {{input_bg}};
    color: {{input_text}};
    border: 1px solid {{input_border}};
    border-radius: 3px;
    padding: 3px 8px;
}

QComboBox::drop-down {
    background-color: {{button_bg}};
    border: none;
    border-left: 1px solid {{border}};
    width: 20px;
}

QComboBox::down-arrow {
    image: url({{icon_path}}/arrow-down.svg);
    width: 8px;
    height: 5px;
}

QComboBox QAbstractItemView {
    background-color: {{input_bg}};
    color: {{text}};
    border: 1px solid {{border}};
    selection-background-color: {{selection_bg}};
    selection-color: {{selection_text}};
}

/* --- TextBrowser (Lyrics-Anzeige) --- */
QTextBrowser {
    background-color: {{input_bg}};
    color: {{text}};
    border: 1px solid {{input_border}};
    border-radius: 3px;
    padding: 6px;
    font-size: {{font_size}};
}

/* --- RadioButton --- */
QRadioButton {
    background-color: transparent;
    color: {{text}};
    spacing: 6px;
}

QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid {{indicator_bg}};
    border-radius: 7px;
    background-color: {{indicator_bg}};
}

QRadioButton::indicator:checked {
    background-color: {{indicator_check}};
    border-color: {{indicator_check}};
}

/* --- Labels --- */
QLabel {
    background-color: transparent;
    color: {{text}};
}

/* --- Checkboxen --- */
QCheckBox {
    background-color: transparent;
    color: {{text}};
    spacing: 6px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid {{indicator_bg}};
    border-radius: 3px;
    background-color: {{indicator_bg}};
}

QCheckBox::indicator:checked {
    background-color: {{indicator_check}};
    border-color: {{indicator_check}};
    image: url({{icon_path}}/check.svg);
}

/* --- Slider (Position) --- */
QSlider::groove:horizontal {
    background-color: {{slider_groove}};
    height: 6px;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background-color: {{slider_handle}};
    width: 16px;
    height: 16px;
    margin: -5px 0;
    border-radius: 8px;
    border: 1px solid {{border}};
}

QSlider::handle:horizontal:hover {
    background-color: {{button_hover}};
}

/* --- ScrollArea (Viewport + Inhalt, z.B. SongData) --- */
/* QScrollArea erstellt ein eigenes viewport-QWidget, das nicht via
   QDockWidget > QWidget gestylt wird — daher explizit setzen. */
QScrollArea {
    background-color: {{widget_bg}};
    border: none;
}

QScrollArea > QWidget,
QScrollArea > QWidget > QWidget {
    background-color: {{widget_bg}};
}

/* --- Scrollbars --- */
QScrollBar:vertical {
    background-color: {{scrollbar_bg}};
    width: 12px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: {{scrollbar_handle}};
    min-height: 20px;
    border-radius: 4px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: {{text_dim}};
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: {{scrollbar_bg}};
    height: 12px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: {{scrollbar_handle}};
    min-width: 20px;
    border-radius: 4px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: {{text_dim}};
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* --- Menue --- */
QMenuBar {
    background-color: {{title_bg}};
    color: {{title_text}};
    border-bottom: 1px solid {{border}};
}

QMenuBar::item:selected {
    background-color: {{menu_hover}};
}

QMenu {
    background-color: {{menu_bg}};
    color: {{text}};
    border: 1px solid {{border}};
}

QMenu::item:selected {
    background-color: {{menu_hover}};
    color: {{selection_text}};
}

QMenu::separator {
    height: 1px;
    background-color: {{border}};
    margin: 4px 8px;
}

/* --- Tooltips --- */
QToolTip {
    background-color: {{tooltip_bg}};
    color: {{tooltip_text}};
    border: 1px solid {{border}};
    padding: 4px;
    font-size: {{font_size}};
}

/* --- Tab-Bar (fuer Tabbed Docking) --- */
QTabBar::tab {
    background-color: {{title_bg}};
    color: {{title_text}};
    border: 1px solid {{border}};
    padding: 6px 12px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: {{widget_bg}};
    color: {{text}};
    border-bottom-color: {{widget_bg}};
    border-top: 2px solid {{selection_bg}};
    font-weight: bold;
}

QTabBar::tab:hover {
    background-color: {{button_bg}};
    color: {{button_text}};
}

/* --- GroupBox --- */
QGroupBox {
    background-color: {{widget_bg}};
    border: 1px solid {{border}};
    border-radius: 4px;
    margin-top: 8px;
    padding-top: 8px;
    color: {{text}};
}

QGroupBox::title {
    subcontrol-origin: margin;
    padding: 0 6px;
    color: {{text}};
}

/* --- FormLayout Labels --- */
QFormLayout QLabel {
    color: {{text_dim}};
}

/* --- MessageBox --- */
QMessageBox {
    background-color: {{widget_bg}};
    color: {{text}};
}

/* --- InputDialog --- */
QInputDialog {
    background-color: {{widget_bg}};
    color: {{text}};
}

/* --- Club-Button Warnzustand (wird per Code gesetzt, skin-kompatibel) --- */
QPushButton[warning="true"] {
    background-color: {{warning}};
    color: white;
    font-weight: bold;
    padding: 10px 14px;
}

QPushButton[warning="true"]:hover {
    background-color: {{warning_hover}};
}

/* --- Confirm-Button (gruener Haken, wiederverwendbar) --- */
QPushButton[confirm="true"] {
    background-color: {{confirm}};
    color: white;
    font-weight: bold;
    padding: 10px 14px;
}

QPushButton[confirm="true"]:hover {
    background-color: {{confirm_hover}};
}


/* --- Splitter-Griff (z.B. Planner Pool/Playlist) --- */
QSplitter::handle {
    background-color: {{border}};
}
QSplitter::handle:horizontal { width: 4px; }
QSplitter::handle:vertical { height: 4px; }
QSplitter::handle:hover {
    background-color: {{button_bg}};
}

/* --- Schmale Datei-Dialog-/Aktions-Buttons ("..."): kein breites Padding --- */
QPushButton#fileBtn {
    padding: 2px 2px;
}
