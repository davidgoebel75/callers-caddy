# .gitattributes fuer Callers Caddy
# ---------------------------------
# Zeilenenden vereinheitlichen: im Repo und beim Checkout immer LF.
# Ersetzt das fruehere "* -text", das die interne EOL-Mischung nur konserviert
# hat (siehe intern#71) statt sie zu verhindern.
* text=auto eol=lf

# Inno-Setup-Skript: ISCC bevorzugt CRLF, bleibt explizit aussen vor.
*.iss text eol=crlf

# Binaerdateien: nie anfassen
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.mp3  binary
*.wav  binary
*.flac binary
*.ogg  binary
*.zip  binary
*.exe  binary
*.dll  binary
*.pyd  binary
*.ttf  binary
*.otf  binary
