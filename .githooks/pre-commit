#!/bin/sh
# Pre-Commit-Hook (intern#128): Einstellungs-Tests vor jedem Commit, der
# src/*.py oder src/*.json anfasst. Faengt fehlende Uebersetzungen und
# fehlende SETTINGS_META-Eintraege schon beim Commit ab, nicht erst in der CI.
# Aktivieren (einmal pro Klon): git config core.hooksPath .githooks
# Notfall: git commit --no-verify

git diff --cached --name-only --diff-filter=ACMR -- 'src/*.py' 'src/*.json' | grep -q . || exit 0

# Python aus der Projekt-venv, sonst das aus dem PATH
if [ -x .venv/Scripts/python.exe ]; then PY=.venv/Scripts/python.exe
elif [ -x .venv/bin/python ]; then PY=.venv/bin/python
else PY=python
fi

# ponytail: prueft den Arbeitsstand, nicht nur den gestagten Inhalt.
# Teil-Staging (git add -p) kann so durchrutschen; die CI faengt es dann.
QT_QPA_PLATFORM=offscreen "$PY" -m pytest -q --no-header -p no:cacheprovider \
    tests/test_settings_i18n.py tests/test_settings_reachable.py || {
    echo
    echo "pre-commit: Einstellungs-Tests fehlgeschlagen, Commit abgebrochen."
    echo "Im Notfall: git commit --no-verify"
    exit 1
}
